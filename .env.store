# The Google Play build (`npm run build:store`, vite mode "store", output dist-store/, the folder Capacitor copies).
# Every VITE_ value ends up in the bundle as plain text: nothing secret belongs here (the ElevenLabs key stays in .env.local).
VITE_PLATFORM=capacitor
VITE_SOUNDBOARD=off
# Store accounts (2026-11-11): AdMob app 냥이 수비대 (app id in android/gradle.properties), RevenueCat project app 냥이 수비대.
VITE_ADMOB_REWARDED_ID=ca-app-pub-9889470750416047/5270110646
VITE_REVENUECAT_API_KEY=goog_DPJJblhLnlWsCTtZlmZsitDgSUl
# Google Play Games: the endless leaderboard's id from Play Console (Play Games Services, Leaderboards), and android/gradle.properties pgsProjectId.
# Firebase web app config (console, project settings, your apps; public values, docs/계정_Firebase.md). Without it: no account.
VITE_FIREBASE_API_KEY=AIzaSyAqsnsijNmU_Fdf9ZOysddoiGSZZFjETv0
VITE_FIREBASE_PROJECT_ID=meowguard-4ce6f
VITE_FIREBASE_APP_ID=1:837064889610:web:ae4b2bdbe7203f5ac096f3
VITE_FIREBASE_AUTH_DOMAIN=meowguard-4ce6f.firebaseapp.com
# Play Games achievements: JSON of game key to Play Console id, e.g. {"first_win":"CgkI..."}.
# VITE_PGS_ACHIEVEMENTS=
# The privacy policy and terms are public/legal/ on the web build's GitHub Pages site (tools/deploy_pages.sh).
VITE_PRIVACY_URL=https://kymmmm01.github.io/Project1/legal/privacy.html
VITE_TERMS_URL=https://kymmmm01.github.io/Project1/legal/terms.html
VITE_SUPPORT_URL=mailto:dbals498@gmail.com
# An internal test build only: VITE_DEBUG=on (QA hooks and cheats), VITE_ADMOB_TESTING=1 (test ads).
