{
  "name": "meow-guard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:store": "tsc --noEmit && vite build --mode store --outDir dist-store --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "font": "node scripts/build-font.mjs",
    "sim": "vitest run --config vitest.sim.config.ts",
    "predev": "node scripts/build-font.mjs",
    "prebuild": "node scripts/build-font.mjs",
    "prebuild:store": "node scripts/build-font.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@revenuecat/purchases-capacitor": "^14.1.0",
    "firebase": "~12.19.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "@expo-google-fonts/jua": "^0.4.1",
    "@expo-google-fonts/lilita-one": "^0.4.1",
    "@types/node": "^26.6.4",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
